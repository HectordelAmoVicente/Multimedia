<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Bars">
    <TextView
        android:id="@+id/textViewFacilities"
        android:text="Instalaciones"
        android:textSize="30sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />
    <SeekBar
        android:id="@+id/seekBarFacilities"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/textViewFacilities"
        app:layout_constraintStart_toStartOf="@id/textViewFacilities"
        app:layout_constraintEnd_toEndOf="@id/textViewFacilities"
        android:thumb="@android:drawable/btn_star"
        android:max="5"
        android:min="0"
        style="@android:style/Widget.Material.SeekBar.Discrete"
        android:progress="5"
        android:progressTint="@color/black"
        android:thumbTint="@color/black"
        android:progressBackgroundTint="@color/teal_200"
        />
    <TextView
        android:id="@+id/textViewCleaning"
        android:text="Limpieza"
        android:textSize="30sp"
        app:layout_constraintStart_toStartOf="@id/textViewFacilities"
        app:layout_constraintTop_toBottomOf="@id/seekBarFacilities"
        android:layout_marginStart="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />
    <RatingBar
        android:id="@+id/ratingBarCleaning"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        app:layout_constraintStart_toStartOf="@id/textViewFacilities"
        app:layout_constraintTop_toBottomOf="@id/textViewCleaning"
        />
    <TextView
        android:id="@+id/textViewCanteen"
        android:text="Cafetería"
        android:textSize="30sp"
        app:layout_constraintStart_toStartOf="@id/textViewFacilities"
        app:layout_constraintTop_toBottomOf="@id/ratingBarCleaning"
        android:layout_marginStart="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />
    <RatingBar
        android:id="@+id/ratingBarCanteen"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        app:layout_constraintStart_toStartOf="@id/textViewFacilities"
        app:layout_constraintTop_toBottomOf="@id/textViewCanteen"
        />
    <Button
        android:id="@+id/buttonEnd"
        android:text="Fin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/textViewFacilities"
        app:layout_constraintTop_toBottomOf="@id/ratingBarCanteen"
    />
</androidx.constraintlayout.widget.ConstraintLayout>