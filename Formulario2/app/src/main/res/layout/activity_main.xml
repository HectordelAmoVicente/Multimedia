<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Main"
    >

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="40dp"
        android:text="Formulario"
        android:textSize="35sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <AutoCompleteTextView
        android:id="@+id/autoCompleteTextViewNickname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Introduce aquí tu apodo"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/title"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:completionThreshold="1"
        />
    <EditText
        android:id="@+id/editTextName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Introduce aquí tu nombre"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/autoCompleteTextViewNickname"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        />
    <EditText
        android:id="@+id/editTextLocality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Localidad"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/editTextName"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        />
    <EditText
        android:id="@+id/editTextAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Domicilio"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/editTextLocality"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        />
    <TextView
        android:id="@+id/textViewCourse"
        android:textSize="20sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/editTextAddress"
        app:layout_constraintStart_toStartOf="@id/title"
        android:text="Elige curso:"
        android:layout_marginTop="50dp"
        />
    <RadioGroup
        android:id="@+id/radioGroupCourses"
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        app:layout_constraintBottom_toBottomOf="@id/textViewCourse"
        app:layout_constraintStart_toEndOf="@id/textViewCourse"
        android:orientation="horizontal">
        <RadioButton
            android:id="@+id/radioButtonFirst"
            android:text="Primero"
            android:textSize="12sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <RadioButton
            android:id="@+id/radioButtonSecond"
            android:text="Segundo"
            android:textSize="12sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </RadioGroup>
    <TextView
        android:id="@+id/textViewExtraServices"
        android:textSize="20sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/radioGroupCourses"
        app:layout_constraintStart_toStartOf="@id/title"
        android:text="Elige servicios adicionales:"
        android:layout_marginTop="50dp"
        />
    <CheckBox
        android:id="@+id/checkBoxDining"
        android:text="Comedor"
        android:textSize="14sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/textViewExtraServices"
        app:layout_constraintStart_toStartOf="@+id/title"
        />
    <CheckBox
        android:id="@+id/checkBoxParking"
        android:text="Parking"
        android:textSize="14sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/textViewExtraServices"
        app:layout_constraintStart_toEndOf="@+id/checkBoxDining"
        />
    <CheckBox
        android:id="@+id/checkBoxLocker"
        android:text="Taquilla"
        android:textSize="14sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/textViewExtraServices"
        app:layout_constraintStart_toEndOf="@+id/checkBoxParking"
        />

    <TextView
        android:id="@+id/textViewTerms"
        android:text="Acepto los términos y condiciones"
        android:textSize="20sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/textViewExtraServices"
        app:layout_constraintStart_toStartOf="@id/title"
        android:layout_marginTop="80dp"
        />
    <Switch
        android:id="@+id/switchTerms"
        android:layout_width="60dp"
        android:layout_height="20dp"
        app:layout_constraintTop_toTopOf="@id/textViewTerms"
        app:layout_constraintStart_toEndOf="@id/textViewTerms"
        />
    <Button
        android:id="@+id/buttonFillOut"
        android:text="RELLENAR"
        android:textSize="14sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/textViewTerms"
        app:layout_constraintStart_toStartOf="@id/title"
        android:layout_marginTop="50dp"
        />
    <ToggleButton
        android:id="@+id/toggleButtonTextSize"
        android:textSize="14sp"
        android:textOff="TEXTO PEQUEÑO"
        android:textOn="TEXTO GRANDE"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/buttonFillOut"
        app:layout_constraintStart_toEndOf="@id/buttonFillOut"
        />
    <ImageButton
        android:id="@+id/imageButtonClear"
        android:src="@android:drawable/ic_menu_delete"
        android:background="@android:color/holo_red_light"
        android:layout_width="80dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toTopOf="@id/toggleButtonTextSize"
        app:layout_constraintStart_toEndOf="@id/toggleButtonTextSize"
        />



</androidx.constraintlayout.widget.ConstraintLayout>