<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Main">
    <TextView
        android:id="@+id/textViewTitle"
        android:textSize="30sp"
        android:fontFamily="monospace"
        android:textColor="@color/black"
        android:text="Frutería Héctor"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50px"
        />

    <ImageView
        android:id="@+id/apple"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/manzana"
        app:layout_constraintStart_toStartOf="@id/textViewTitle"
        app:layout_constraintTop_toBottomOf="@id/textViewTitle"
        android:layout_marginTop="30px"/>
    <Button
        android:id="@+id/buttonSusApple"
        android:layout_width="80dp"
        android:layout_height="40dp"
        android:text="-"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:backgroundTint="#F44336"
        app:layout_constraintStart_toEndOf="@id/apple"
        app:layout_constraintTop_toTopOf="@id/apple"
        app:layout_constraintBottom_toBottomOf="@id/apple"
        android:layout_marginLeft="20dp"/>
    <TextView
        android:id="@+id/textViewAppleCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        app:layout_constraintStart_toEndOf="@id/buttonSusApple"
        app:layout_constraintTop_toTopOf="@id/buttonSusApple"
        app:layout_constraintBottom_toBottomOf="@id/buttonSusApple"
        android:layout_marginLeft="10dp"/>
    <Button
        android:id="@+id/buttonSumApple"
        android:layout_width="80dp"
        android:layout_height="40dp"
        android:text="+"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:backgroundTint="#4CAF50"
        app:layout_constraintStart_toEndOf="@id/textViewAppleCounter"
        app:layout_constraintTop_toTopOf="@id/textViewAppleCounter"
        app:layout_constraintBottom_toBottomOf="@id/textViewAppleCounter"
        android:layout_marginLeft="10dp"/>
    <ImageView
        android:id="@+id/kiwi"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/kiwi"
        app:layout_constraintStart_toStartOf="@id/apple"
        app:layout_constraintTop_toBottomOf="@id/apple"
        android:layout_marginTop="30px"/>
    <Button
        android:id="@+id/buttonSusKiwi"
        android:layout_width="80dp"
        android:layout_height="40dp"
        android:text="-"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:backgroundTint="#F44336"
        app:layout_constraintStart_toEndOf="@id/kiwi"
        app:layout_constraintTop_toTopOf="@id/kiwi"
        app:layout_constraintBottom_toBottomOf="@id/kiwi"
        android:layout_marginLeft="20dp"/>
    <TextView
        android:id="@+id/textViewKiwiCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        app:layout_constraintStart_toEndOf="@id/buttonSusKiwi"
        app:layout_constraintTop_toTopOf="@id/buttonSusKiwi"
        app:layout_constraintBottom_toBottomOf="@id/buttonSusKiwi"
        android:layout_marginLeft="10dp"/>
    <Button
        android:id="@+id/buttonSumKiwi"
        android:layout_width="80dp"
        android:layout_height="40dp"
        android:text="+"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:backgroundTint="#4CAF50"
        app:layout_constraintStart_toEndOf="@id/textViewKiwiCounter"
        app:layout_constraintTop_toTopOf="@id/textViewKiwiCounter"
        app:layout_constraintBottom_toBottomOf="@id/textViewKiwiCounter"
        android:layout_marginLeft="10dp"/>
    <ImageView
        android:id="@+id/banana"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/platano"
        app:layout_constraintStart_toStartOf="@id/kiwi"
        app:layout_constraintTop_toBottomOf="@id/kiwi"
        android:layout_marginTop="30px"/>
    <Button
        android:id="@+id/buttonSusBanana"
        android:layout_width="80dp"
        android:layout_height="40dp"
        android:text="-"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:backgroundTint="#F44336"
        app:layout_constraintStart_toEndOf="@id/banana"
        app:layout_constraintTop_toTopOf="@id/banana"
        app:layout_constraintBottom_toBottomOf="@id/banana"
        android:layout_marginLeft="20dp"/>
    <TextView
        android:id="@+id/textViewBananaCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        app:layout_constraintStart_toEndOf="@id/buttonSusBanana"
        app:layout_constraintTop_toTopOf="@id/buttonSusBanana"
        app:layout_constraintBottom_toBottomOf="@id/buttonSusBanana"
        android:layout_marginLeft="10dp"/>
    <Button
        android:id="@+id/buttonSumBanana"
        android:layout_width="80dp"
        android:layout_height="40dp"
        android:text="+"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:backgroundTint="#4CAF50"
        app:layout_constraintStart_toEndOf="@id/textViewBananaCounter"
        app:layout_constraintTop_toTopOf="@id/textViewBananaCounter"
        app:layout_constraintBottom_toBottomOf="@id/textViewBananaCounter"
        android:layout_marginLeft="10dp"/>
    <ImageView
        android:id="@+id/pear"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/pera"
        app:layout_constraintStart_toStartOf="@id/banana"
        app:layout_constraintTop_toBottomOf="@id/banana"
        android:layout_marginTop="30px"/>
    <Button
        android:id="@+id/buttonSusPear"
        android:layout_width="80dp"
        android:layout_height="40dp"
        android:text="-"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:backgroundTint="#F44336"
        app:layout_constraintStart_toEndOf="@id/pear"
        app:layout_constraintTop_toTopOf="@id/pear"
        app:layout_constraintBottom_toBottomOf="@id/pear"
        android:layout_marginLeft="20dp"/>
    <TextView
        android:id="@+id/textViewPearCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        app:layout_constraintStart_toEndOf="@id/buttonSusPear"
        app:layout_constraintTop_toTopOf="@id/buttonSusPear"
        app:layout_constraintBottom_toBottomOf="@id/buttonSusPear"
        android:layout_marginLeft="10dp"/>
    <Button
        android:id="@+id/buttonSumPear"
        android:layout_width="80dp"
        android:layout_height="40dp"
        android:text="+"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:backgroundTint="#4CAF50"
        app:layout_constraintStart_toEndOf="@id/textViewPearCounter"
        app:layout_constraintTop_toTopOf="@id/textViewPearCounter"
        app:layout_constraintBottom_toBottomOf="@id/textViewPearCounter"
        android:layout_marginLeft="10dp"/>
    <TextView
        android:id="@+id/textViewGeneralCounter"
        android:text="Has seleccionado 0 artículos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/pear"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50px"/>
    <Button
        android:id="@+id/buttonConfirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:text="CONFIRMAR COMPRA"
        android:backgroundTint="#2196F3"
        app:layout_constraintTop_toBottomOf="@id/textViewGeneralCounter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50px"/>



</androidx.constraintlayout.widget.ConstraintLayout>